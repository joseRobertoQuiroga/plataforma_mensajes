{
  "name": "wibsite-helper",
  "version": "2.1.1",
  "description": "Helper service for Wibsite Business - integration logic between Chatwoot, Dify, n8n, and Twenty CRM",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --forceExit",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch --forceExit",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --forceExit",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --forceExit --runTestsByPath __tests__/agentConfig.test.js __tests__/antiHallucination.test.js __tests__/conversation.test.js __tests__/leadProfile.test.js __tests__/rateLimiter.test.js __tests__/ragEngine.test.js __tests__/security.test.js __tests__/tenantContext.test.js",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --forceExit --runTestsByPath __tests__/integration.test.js",
    "test:smoke": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --forceExit --runTestsByPath __tests__/smoke.test.js",
    "test:contract": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --forceExit --runTestsByPath __tests__/contract.test.js",
    "test:contract-ext": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --forceExit --runTestsByPath __tests__/contract-integrations.test.js",
    "test:flow": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --forceExit --runTestsByPath __tests__/flow.test.js",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --forceExit --runTestsByPath __tests__/integration.test.js __tests__/smoke.test.js __tests__/contract.test.js __tests__/flow.test.js",
    "test:ci": "npm run test:unit && npm run test:integration && npm run test:smoke && npm run test:contract && npm run test:contract-ext && npm run test:flow"
  },
  "dependencies": {
    "axios": "^1.15.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "ioredis": "^5.4.1",
    "minio": "^8.0.4",
    "multer": "^2.2.0",
    "pg": "^8.13.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "@sentry/node": "^8.0.0",
    "@langchain/core": "^0.3.40",
    "@langchain/langgraph": "^0.2.53",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  }
}
