{
  "name": "TEVS Auto-Remediation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "tevs-alert",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "Webhook (TEVS Kibana)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.body.level}}",
              "value2": "error"
            }
          ]
        }
      },
      "name": "If Critical Failure",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "chatId": "wibsite-ops-team",
        "text": "=URGENT: A TEVS Deployment Gate failed!\nTest ID: {{$json.body.test_id}}\nExecution ID: {{$json.body.execution_id}}\nInitiating automatic rollback procedures..."
      },
      "name": "Notify Chatwoot/Slack",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [
        680,
        180
      ]
    },
    {
      "parameters": {
        "command": "echo 'Simulating rollback script...'; exit 0"
      },
      "name": "Execute Rollback Script",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        680,
        420
      ]
    }
  ],
  "connections": {
    "Webhook (TEVS Kibana)": {
      "main": [
        [
          {
            "node": "If Critical Failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "If Critical Failure": {
      "main": [
        [
          {
            "node": "Notify Chatwoot/Slack",
            "type": "main",
            "index": 0
          },
          {
            "node": "Execute Rollback Script",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {}
}
