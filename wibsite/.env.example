# ═══════════════════════════════════════════════════════════
# Wibsite Business — Variables de Entorno (Template)
# ═══════════════════════════════════════════════════════════

# ─── Shared Database ─────────────────────────────────────
POSTGRES_USER=wibsite
POSTGRES_PASSWORD=wibsite_pass

# ─── Data Store Mode ─────────────────────────────────────
STORE_MODE=dual

# ─── Chatwoot ────────────────────────────────────────────
CHATWOOT_PORT=3002
CHATWOOT_FRONTEND_URL=http://localhost:3002
CHATWOOT_SECRET_KEY=<generar: openssl rand -hex 64>
CHATWOOT_API_KEY=
CHATWOOT_INBOX_IDENTIFIER=

# ─── Dify ────────────────────────────────────────────────
DIFY_API_PORT=5001
DIFY_WEB_PORT=3003
DIFY_ADMIN_PASSWORD=admin123
DIFY_SECRET_KEY=<generar: openssl rand -hex 32>
DIFY_API_KEY=
PLUGIN_DAEMON_KEY=<generar: openssl rand -hex 32>
PLUGIN_DIFY_INNER_API_KEY=<generar: openssl rand -hex 32>

# ─── Twilio (puente WhatsApp/SMS hasta migración Meta) ───
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_SANDBOX_NUMBER=+14155238886

# ─── n8n ─────────────────────────────────────────────────
N8N_PORT=5679
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5679
N8N_ENCRYPTION_KEY=<generar: openssl rand -hex 32>

# ─── Twenty CRM ─────────────────────────────────────────
TWENTY_PORT=3001
TWENTY_SERVER_URL=http://localhost:3001
TWENTY_FRONTEND_URL=http://localhost:3001
TWENTY_ACCESS_TOKEN_SECRET=<generar: openssl rand -hex 32>
TWENTY_LOGIN_TOKEN_SECRET=<generar: openssl rand -hex 32>
TWENTY_REFRESH_TOKEN_SECRET=<generar: openssl rand -hex 32>
TWENTY_FILE_TOKEN_SECRET=<generar: openssl rand -hex 32>
TWENTY_API_KEY=
TWENTY_API_URL=http://localhost:3001
TWENTY_ENCRYPTION_KEY=<generar: openssl rand -hex 32>

# ─── Helper Node ─────────────────────────────────────────
HELPER_PORT=3100
HELPER_API_KEY=<generar: openssl rand -hex 32>
REDIS_URL=redis://redis:6379
WEAVIATE_URL=http://weaviate:8080
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# ─── Stack Elástico / Observabilidad (OTel → Elasticsearch) ─
STACK_VERSION=9.4.2
ELASTIC_PASSWORD=<generar: openssl rand -hex 32>
KIBANA_PASSWORD=<generar: openssl rand -hex 32>
ES_JAVA_OPTS=-Xms1g -Xmx1g
ELASTICSEARCH_HOST=elasticsearch
ELASTIC_OTLP_ENDPOINT=http://otel-collector:4318
KIBANA_SERVICE_TOKEN=<generar: openssl rand -hex 32>
ELASTIC_OTEL_API_KEY=<generar: openssl rand -hex 32>
KIBANA_ENCRYPTION_KEY=<generar: openssl rand -hex 32>

# ─── MinIO (Object Storage) ─────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=<generar: openssl rand -hex 32>

# ─── Meta / WhatsApp (para futuro, usar Twilio mientras) ─
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v21.0
META_WEBHOOK_VERIFY_TOKEN=wibsite_verify_2026
META_APP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ─── Multicanal (Email · Telegram · TikTok · Messenger) ────
# Telegram (canal de pruebas principal — Bot API, gratis)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Messenger (Meta Graph API)
MESSENGER_PAGE_TOKEN=
MESSENGER_VERIFY_TOKEN=
# Email (API HTTP de proveedor: Resend/Postmark/Mailgun/SendGrid)
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=
# TikTok (API de comentarios requiere aprobación; o agregador intermedio)
TIKTOK_API_URL=
TIKTOK_API_KEY=
# Multimodal vía OpenRouter (STT para audio; visión para imágenes)
OPENROUTER_STT_MODEL=
OPENROUTER_VISION_MODEL=openai/gpt-4o-mini

# ─── Authelia SSO ─────────────────────────────────────────
AUTHELIA_JWT_SECRET=<generar: openssl rand -hex 64>
AUTHELIA_SESSION_SECRET=<generar: openssl rand -hex 64>
AUTHELIA_STORAGE_ENCRYPTION_KEY=<generar: openssl rand -hex 32>
AUTHELIA_ADMIN_EMAIL=admin@wibsite.com
AUTHELIA_ADMIN_PASSWORD=Admin@123

# ─── n8n environment ─────────────────────────────────────
N8N_TELEMETRY_DISABLED=true
