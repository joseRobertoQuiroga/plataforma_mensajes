# ═══════════════════════════════════════════════════════════
# Wibsite Business — Variables de Entorno
# ═══════════════════════════════════════════════════════════

# ─── Shared Database ─────────────────────────────────────
POSTGRES_USER=wibsite
POSTGRES_PASSWORD=wibsite_pass

# ─── Chatwoot ────────────────────────────────────────────
CHATWOOT_PORT=3002
CHATWOOT_FRONTEND_URL=http://localhost:3002
CHATWOOT_SECRET_KEY=<generar: openssl rand -hex 64>

# ─── Dify ────────────────────────────────────────────────
DIFY_API_PORT=5001
DIFY_WEB_PORT=3003
DIFY_ADMIN_PASSWORD=admin123
DIFY_SECRET_KEY=<generar: openssl rand -hex 32>

# ─── n8n ─────────────────────────────────────────────────
N8N_PORT=5678
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678
N8N_ENCRYPTION_KEY=<generar: openssl rand -hex 32>

# ─── Twenty CRM ─────────────────────────────────────────
TWENTY_PORT=3001
TWENTY_SERVER_URL=http://localhost:3001
TWENTY_FRONTEND_URL=http://localhost:3001
TWENTY_ACCESS_TOKEN_SECRET=<generar: openssl rand -hex 32>
TWENTY_LOGIN_TOKEN_SECRET=<generar: openssl rand -hex 32>
TWENTY_REFRESH_TOKEN_SECRET=<generar: openssl rand -hex 32>
TWENTY_FILE_TOKEN_SECRET=<generar: openssl rand -hex 32>

# ─── Helper Node ─────────────────────────────────────────
HELPER_PORT=3100
HELPER_API_KEY=<generar: openssl rand -hex 32>
REDIS_URL=redis://redis:6379
WEAVIATE_URL=http://weaviate:8080

# ─── Meta / WhatsApp (configurar después de crear la app) ─
# Ver: https://developers.facebook.com/
META_APP_ID=1694506861827055
META_APP_SECRET=
META_API_VERSION=v21.0
META_WEBHOOK_VERIFY_TOKEN=wibsite_verify_2026
META_APP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=1287367854450926
WHATSAPP_BUSINESS_ACCOUNT_ID=1024953670257131

# ─── Twenty CRM API Credentials (se generan en init) ────
TWENTY_API_KEY=
TWENTY_API_URL=http://localhost:3001

# ─── Dify API Credentials (se generan en init) ──────────
DIFY_ADMIN_EMAIL=admin@wibsite.com
DIFY_API_KEY=

# ─── Chatwoot API Credentials (se generan en init) ──────
CHATWOOT_ADMIN_EMAIL=admin@wibsite.com
CHATWOOT_ADMIN_PASSWORD=Admin@123
CHATWOOT_API_KEY=
CHATWOOT_ACCOUNT_ID=

# ─── Authelia SSO ─────────────────────────────────────────
AUTHELIA_JWT_SECRET=<generar: openssl rand -hex 64>
AUTHELIA_SESSION_SECRET=<generar: openssl rand -hex 64>
AUTHELIA_ADMIN_EMAIL=admin@wibsite.com
AUTHELIA_ADMIN_PASSWORD=Admin@123
